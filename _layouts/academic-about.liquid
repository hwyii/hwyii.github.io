---
layout: academic
---
<div class="profile-layout">
  <aside class="sidebar" aria-label="Personal profile">
    <div class="profile-photo-wrap">
      <img src="{{ page.profile.image | prepend: '/assets/img/' | relative_url }}" alt="Weiyi He" fetchpriority="high">
    </div>
    <h1 class="profile-name">Weiyi He <span class="profile-name-zh">贺维易</span></h1>
    <div class="profile-title">Ph.D. candidate at <a href="https://msu.edu/">Michigan State University</a></div>
    {% include academic-social.liquid %}
  </aside>
  <div class="main-content">
    <section class="section bio" id="about" data-nav-section aria-label="About Weiyi">{{ content }}</section>
    {% if page.announcements.enabled %}
      {% assign news = site.news | sort: 'date' | reverse %}
      <section class="section" id="news" data-nav-section aria-labelledby="news-title">
        <h2 class="section-title" id="news-title">News<span class="title-emoji" aria-hidden="true">📰</span></h2>
        <ul class="news-list" id="news-list">
          {% for item in news %}
            <li
              class="news-item"
              {% if forloop.index > 4 %}
                data-extra-news
              {% endif %}
            >
              <time class="news-date" datetime="{{ item.date | date: '%Y-%m-%d' }}">{{ item.date | date: '%b %Y' }}</time>
              <div class="news-text">
                {% if item.inline -%}
                  {{- item.content -}}
                {%- else -%}
                  <a href="{{ item.url | relative_url }}">{{ item.title }}</a>
                {%- endif %}
              </div>
            </li>
          {% endfor %}
        </ul>
        {% if news.size > 4 -%}
          <button type="button" class="news-toggle" aria-expanded="false" aria-controls="news-list" hidden>
            Show {{ news.size | minus: 4 }} more
          </button>
        {%- endif %}
      </section>
    {% endif %}
    {% if page.selected_papers %}
      <section class="section" id="publications" data-nav-section aria-labelledby="publications-title">
        <h2 class="section-title" id="publications-title">Selected Publications<span class="title-emoji" aria-hidden="true">📚</span></h2>
        <div class="pub-list">{% bibliography --query @*[selected=true]* --template academic-bib --group_by none %}</div>
        <p class="pub-footnote"><a href="{{ '/publications/' | relative_url }}">View all publications →</a></p>
      </section>
    {% endif %}
    <section class="section" id="internships" data-nav-section aria-labelledby="internships-title">
      <h2 class="section-title" id="internships-title">Experience<span class="title-emoji" aria-hidden="true">💼</span></h2>
      <ol class="timeline">
        <li class="timeline-item">
          <div class="timeline-when">
            <time>Jun – Aug 2026</time>
            <span class="timeline-kind">Industry Research</span>
          </div>
          <div class="timeline-rail">
            <img class="timeline-logo timeline-logo--amazon" src="{{ '/assets/img/company/amazon.svg' | relative_url }}" alt="" aria-hidden="true">
          </div>
          <div class="timeline-body">
            <h3 class="timeline-org">Amazon AGI</h3>
            <p class="timeline-role">Applied Scientist Intern</p>
            <p class="timeline-people">Mentors: Giuseppe Vietri, Dionysis Manousakas &amp; Dmitriy Bespalov</p>
          </div>
        </li>
        <li class="timeline-item">
          <div class="timeline-when">
            <time>2024 – present</time>
            <span class="timeline-kind">Education</span>
          </div>
          <div class="timeline-rail">
            <img class="timeline-logo" src="{{ '/assets/img/venues/msu.svg' | relative_url }}" alt="" aria-hidden="true">
          </div>
          <div class="timeline-body">
            <h3 class="timeline-org">Michigan State University</h3>
            <p class="timeline-role">Ph.D. in Statistics and Computer Science</p>
            <p class="timeline-people">Advisors: Yue Xing &amp; Jiliang Tang</p>
          </div>
        </li>
        <li class="timeline-item">
          <div class="timeline-when">
            <time>2020 – 2024</time>
            <span class="timeline-kind">Education</span>
          </div>
          <div class="timeline-rail">
            <img class="timeline-logo" src="{{ '/assets/img/venues/ustc.svg' | relative_url }}" alt="" aria-hidden="true">
          </div>
          <div class="timeline-body">
            <h3 class="timeline-org">University of Science and Technology of China</h3>
            <p class="timeline-role">B.S. in Statistics</p>
            <p class="timeline-people">Advisor: Yaning Yang</p>
          </div>
        </li>
      </ol>
      <p class="pub-footnote"><a href="{{ '/experience/' | relative_url }}">View full experience →</a></p>
    </section>
  </div>
</div>
