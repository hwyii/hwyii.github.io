<div class="experience-list{% unless include.internships_only %} experience-list--full{% endunless %}">
  <section
    class="experience-group"
    {% if include.internships_only %}
      aria-label="Internships"
    {% else %}
      aria-labelledby="internship-experience-title"
    {% endif %}
  >
    {% unless include.internships_only %}
      <h3 class="experience-group-title" id="internship-experience-title">
        Internship Experience<span class="title-emoji" aria-hidden="true">💼</span>
      </h3>
    {% endunless %}
    <div class="experience-items">
      <article class="experience-item">
        <img class="experience-logo experience-logo--amazon" src="{{ '/assets/img/company/amazon.svg' | relative_url }}" alt="" aria-hidden="true">
        <div class="experience-info">
          <strong>Amazon AGI</strong>
          <span>Applied Scientist Intern · Arlington, VA</span>
        </div>
        <time class="experience-date">Jun 2026 – Aug 2026</time>
        {% unless include.internships_only %}
          <dl class="experience-meta">
            <dt>Focus</dt>
            <dd>LLM robustness to input and parameter perturbations</dd>
            <dt>Mentors</dt>
            <dd class="experience-people">
              <a href="https://www.giuseppevietri.com/">Giuseppe Vietri</a><a href="https://www.cl.cam.ac.uk/~dm754/">Dionysis Manousakas</a
              ><a href="https://github.com/dbespalov">Dmitriy Bespalov</a>
            </dd>
            <dt>Paper</dt>
            <dd>
              <span class="experience-paper"
                >Correlated Across Models, Decoupled Within: Input- and Weight-Space Robustness in LLM Mathematical Reasoning</span
              >
              <span class="experience-status">Under review</span>
            </dd>
          </dl>
        {% endunless %}
      </article>
      <article class="experience-item">
        <img class="experience-logo" src="{{ '/assets/img/company/articuler.png' | relative_url }}" alt="" aria-hidden="true">
        <div class="experience-info">
          <strong>Articuler AI</strong>
          <span>Generative AI Development Intern · San Francisco, CA</span>
        </div>
        <time class="experience-date">Jun 2024 – Aug 2024</time>
      </article>
      <article class="experience-item">
        <img class="experience-logo" src="{{ '/assets/img/company/elven.png' | relative_url }}" alt="" aria-hidden="true">
        <div class="experience-info">
          <strong>Elven</strong>
          <span>Data Engineering Intern · Singapore</span>
        </div>
        <time class="experience-date">Jan 2024 – May 2024</time>
      </article>
    </div>
  </section>

  {% unless include.internships_only %}
    <section class="experience-group" aria-labelledby="teaching-experience-title">
      <h3 class="experience-group-title" id="teaching-experience-title">Teaching Experience<span class="title-emoji" aria-hidden="true">🧑‍🏫</span></h3>
      <div class="experience-items">
        <article class="experience-item">
          <img class="experience-logo experience-logo--seal" src="{{ '/assets/img/venues/msu.svg' | relative_url }}" alt="" aria-hidden="true">
          <div class="experience-info">
            <strong>Michigan State University</strong>
            <span>STT 200: Statistical Methods · Teaching Assistant</span>
          </div>
          <time class="experience-date">Fall 2024 · Spring 2025 · Fall 2026</time>
        </article>
        <article class="experience-item">
          <img class="experience-logo experience-logo--seal" src="{{ '/assets/img/venues/ustc.svg' | relative_url }}" alt="" aria-hidden="true">
          <div class="experience-info">
            <strong>University of Science and Technology of China</strong>
            <span>Linear Algebra (B1) · Teaching Assistant</span>
          </div>
          <time class="experience-date">Spring 2023</time>
        </article>
      </div>
    </section>
  {% endunless %}
</div>
